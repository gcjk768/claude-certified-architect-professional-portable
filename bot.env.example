# Copy to bot.env and fill in. Never commit bot.env.
# From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID: send /whoami to the bot. Several: 111,222
ALLOWED_USER_IDS=
# sonnet | haiku | opus. The tutor call runs once per wrong answer.
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT=180
# Only needed where `claude` is not already logged in (e.g. the NAS container):
# run `claude setup-token` on your PC and paste it here. Or an ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Optional Obsidian movement log (Activity/YYYY/MM/YYYY-MM-DD.md). Empty = off.
VAULT_DIR=
# NAS only: the user the container runs as.
PUID=1000
PGID=10
TZ=Asia/Singapore
# Optional: post everything into a group topic instead of your DM, as chat_id/topic_id
# (example: <TELEGRAM_CHAT_ID>/42). The bot must be a member of the group.
BOT_CHAT=
# Auto-quiz into BOT_CHAT: one question every QUIZ_EVERY_MIN minutes (0 = off) inside QUIZ_HOURS
# (Singapore time), and only after the previous one was answered. /quiz works at any hour.
QUIZ_EVERY_MIN=60
QUIZ_HOURS=09:00-22:59
# Where questions.csv and state.json live inside the container (compose mounts ./data there).
DATA_DIR=/data
